# 복사: copy .env.example .env  (또는 수동으로 server/.env 생성)

# 웹(UI) + API + Socket.IO 동일 PORT

# WATER_LEVEL_POLL_MS: 폴링 주기(ms), 최소 100



SERIAL_PORT=COM1

BAUD_RATE=115200

MODBUS_SLAVE_ID=1

# PLC Modbus 맵 워드 시작=D1001 이면 reg 0~3 (D1001=mm, D1002=상태, D1003=센서에러, D1004=압축공기 배출장치)

MODBUS_REG_START=0

MODBUS_REG_COUNT=4

PLC_D_WATER=1001

PLC_D_ERROR=1002

PLC_D_SENSOR_ERROR=1003
PLC_D_ONOFF=1004
# 현장 신호가 반대면 1 (0↔1 뒤집어 해석 — 표시등·로그 모두)
D1004_INVERT=1

PLC_SENSOR_COUNT=10

MODBUS_TIMEOUT_MS=800

WATER_LEVEL_POLL_MS=500

# 수위 CSV 기록 폴더 (미설정 시 기본: C:\GaramLED-logs\water-level). 1분마다 1줄 기록
# WATER_LEVEL_LOG_DIR=

# D1004 압축공기 배출장치 ON 로그 폴더 (미설정 시 기본: C:\GaramLED-logs\d1004-on)
# D1004_LOG_DIR=

# 서버 로그 폴더 — 콘솔 출력·종료 사유 일자별 기록 (미설정 시 기본: C:\GaramLED-logs\server)
# SERVER_LOG_DIR=

# ── PCB (저감기 상태 1/0) — 미설정 시 비활성 ──
PCB_SERIAL_PORT=COM2
PCB_BAUD_RATE=9600

PORT=8000


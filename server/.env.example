# 복사: copy .env.example .env  (또는 수동으로 server/.env 생성)

# 웹(UI) + API + Socket.IO 동일 PORT

# WATER_LEVEL_POLL_MS: 폴링 주기(ms), 최소 100



SERIAL_PORT=COM1

BAUD_RATE=115200

MODBUS_SLAVE_ID=1

# PLC Modbus 맵 워드 시작=D1001 이면 reg 0,1,2 (D1001=mm, D1002, D1003)

MODBUS_REG_START=0

MODBUS_REG_COUNT=3

PLC_D_WATER=1001

PLC_D_ERROR=1002

PLC_D_SENSOR_ERROR=1003

PLC_SENSOR_COUNT=10

MODBUS_TIMEOUT_MS=800

WATER_LEVEL_POLL_MS=500

PORT=8000


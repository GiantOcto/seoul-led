# 복사: copy .env.example .env  (또는 수동으로 server/.env 생성)

# 웹(UI) + API + Socket.IO 동일 PORT

# WATER_LEVEL_POLL_MS: 폴링 주기(ms), 최소 100



SERIAL_PORT=COM1

BAUD_RATE=115200

MODBUS_SLAVE_ID=1

# PLC Modbus 맵 워드 시작=D1001 이면 reg 0~3 (D1001=mm, D1002=상태, D1003=센서에러, D1004=압축공기 배출장치)

MODBUS_REG_START=0

MODBUS_REG_COUNT=4

PLC_D_WATER=1001

PLC_D_ERROR=1002

PLC_D_SENSOR_ERROR=1003
PLC_D_ONOFF=1004
# 현장 신호가 반대면 1 (0↔1 뒤집어 해석 — 표시등·로그 모두)
D1004_INVERT=1

PLC_SENSOR_COUNT=10

MODBUS_TIMEOUT_MS=800

WATER_LEVEL_POLL_MS=500

# 수위 CSV 기록 폴더 (미설정 시 기본: 프로젝트 루트/logs/water-level). 1분마다 1줄 기록
# WATER_LEVEL_LOG_DIR=

# 수위 CSV 기록값에 더할 설치 기준 오프셋(mm). 기본 250 (LED 화면 표시값과 동일)
# WATER_LEVEL_OFFSET_MM=250

# D1004 압축공기 배출장치 ON 로그 폴더 (미설정 시 기본: 프로젝트 루트/logs/d1004-on)
# D1004_LOG_DIR=

PORT=8000


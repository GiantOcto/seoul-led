# 복사: copy .env.example .env  (또는 수동으로 server/.env 생성)
# 웹(UI) + API + Socket.IO 동일 PORT

PORT=8000

# 디지털 시계 아래 날씨 (기상청 단기예보). 공공데이터포털 인증키, 비워두면 날씨 표시 안 함
KMA_SERVICE_KEY=
# 기상청 격자 좌표 (기본: 성남시 수정·중원구)
KMA_NX=63
KMA_NY=124

# 서버 로그 폴더 — 콘솔 출력·종료 사유 일자별 기록 (미설정 시 기본: 프로젝트 루트/logs/server)
# SERVER_LOG_DIR=
